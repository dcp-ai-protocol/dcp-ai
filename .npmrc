//registry.npmjs.org/:_authToken=${NPM_TOKEN}
# Until @dcp-ai/sdk 2.2.0 is on npm, the root depends on the workspace SDK (file:sdks/typescript).
# Pack it like a registry tarball instead of symlinking it: only its runtime
# dependencies are installed, and the lockfile stays small. Build sdks/typescript first.
install-links=true
