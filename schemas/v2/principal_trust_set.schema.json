{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcp-ai.org/schemas/v2/principal_trust_set.schema.json",
  "title": "PrincipalTrustSet",
  "description": "Principals a verifier trusts and the keys each may sign with (spec/profiles/admission). Supplied by the operator, never derived from a bundle or a request. Implementations also reject a kid that is not derived from its key, a key of the wrong length for its algorithm, and any human_id or kid listed twice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trust_set_version", "principals"],
  "properties": {
    "trust_set_version": { "type": "string", "minLength": 1 },
    "principals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["human_id", "keys"],
        "properties": {
          "human_id": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kid", "alg", "public_key_b64", "status"],
              "properties": {
                "kid": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                "alg": { "type": "string", "enum": ["ed25519", "ml-dsa-65", "slh-dsa-192f"] },
                "public_key_b64": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
                "not_before": { "type": ["string", "null"], "format": "date-time" },
                "expires_at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
