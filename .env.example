# DCP-AI Environment Configuration
# Copy this file to .env and fill in your values.

# Bearer token for admin endpoints (verifier policy/advisories/governance,
# anchor POST /flush, transparency-log POST /gossip/peers). Unset = locked.
# OPERATOR_TOKEN=
# TRUST_PROXY=true                    # only behind a proxy that appends X-Forwarded-For

# ── Verification Service (port 3000) ──
PORT=3000
DCP_VERSION=2.0
VERIFIER_MODE=hybrid_required          # hybrid_required | hybrid_preferred | classical_only | pq_only
REQUIRE_SESSION_BINDING=true
REQUIRE_COMPOSITE_BINDING=true
MAX_KEY_AGE_DAYS=365
ALLOW_V1_BUNDLES=true
PQ_CHECKPOINT_INTERVAL=10
ADVISORY_POLL_INTERVAL_MS=86400000

# ── Anchor Service (port 3001) ──
ANCHOR_MODE=batch                      # batch | individual
BATCH_INTERVAL_MS=60000
# ANCHOR_RPC_URL=https://mainnet.base.org
# ANCHOR_PRIVATE_KEY=0x...
# ANCHOR_CONTRACT=0x...

# ── Transparency Log (port 3002) ──
# LOG_ID=my-log-instance              # Unique identifier for this log instance (auto-generated if omitted)
# OPERATOR_KEY=                        # Ed25519 seed for STHs: 64 hex chars, openssl rand -hex 32 (ephemeral if omitted)
# GOSSIP_PEERS=http://log-b:3002#<b64 key>,http://log-c:3002#<b64 key>   # Peers with pinned Ed25519 keys (their /health public_key)
# GOSSIP_INTERVAL_MS=30000            # Gossip polling interval in milliseconds

# ── Revocation Service (port 3003) ──
# REGISTRATIONS_PER_HOUR=20             # POST /v2/register per client per hour (the gateway reads it too)
# MAX_AGENTS=10000                      # registered agents before new ones get 507
