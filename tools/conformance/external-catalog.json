      "id": "external.dcp-jcs-v1.canonicalize",
      "title": "dcp-jcs-v1 canonical bytes of an external implementation",
      "claim": "For each committed input (JSON text; input_json vectors are sent exactly as committed), the implementation returns the expected dcp-jcs-v1 bytes, or rejects the three committed fractional inputs. It covers the parser the implementation uses plus its canonicalizer on these 30 vectors only.",
      "limits": [
        "Not a complete dcp-jcs-v1 implementation: only these committed vectors.",
        "The dcp-jcs-v2 candidate and new edge cases are outside this suite."
      ],
