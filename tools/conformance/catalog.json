{
  "kit_version": "1.0.0",
  "description": "DCP-AI conformance kit catalog. expected_cases pins every case id a suite must produce: a missing or extra case is an infrastructure error, never a silent reduction of coverage.",
  "limits": [
    "Passing the selected suites certifies those checks on these fixtures only; it does not certify a complete DCP implementation, another SDK or a deployment.",
    "Schema suites prove schema validity only.",
    "Inventory entries are not executed by this kit and are not counted in the totals.",
    "verified and admitted never authorize an action.",
    "Adapters (Express, FastAPI, OpenClaw, the verification server) are not part of this kit."
  ],
  "suites": [
    {
      "id": "v1.schema",
      "title": "V1 core artifacts: JSON Schema",
      "claim": "Each V1 example and the V1 signed bundle validate against their schemas/v1 schema. This proves schema validity only: not signatures, hashes, chaining or behaviour.",
      "requirements": [
        {
          "spec": "spec/DCP-01.md, spec/DCP-02.md, spec/DCP-03.md, spec/BUNDLE.md",
          "schemas": "schemas/v1/*.schema.json",
          "fixtures": "tests/conformance/examples/{responsible_principal_record,agent_passport,intent,policy_decision,audit_entry,citizenship_bundle,citizenship_bundle.signed}.json"
        }
      ],
      "expected_cases": [
        "v1.schema.responsible_principal_record",
        "v1.schema.agent_passport",
        "v1.schema.intent",
        "v1.schema.policy_decision",
        "v1.schema.audit_entry",
        "v1.schema.citizenship_bundle",
        "v1.schema.signed_bundle"
      ]
    },
    {
      "id": "v1.integrity",
      "title": "V1 signed bundle: signature, hashes and audit chain",
      "claim": "The committed V1 signed fixture verifies (Ed25519 over the canonical bundle) with the public key its golden metadata declares, which must equal the fixture signer key and keys/public_key.txt; bundle_hash, Merkle root, intent_hash, audit entry hashes and the prev_hash chain are recomputed and compared with the signature block and with the golden values. One fixture through the reference code: it does not certify another implementation.",
      "requirements": [
        {
          "spec": "spec/VERIFICATION.md (V1), spec/DCP-03.md",
          "schemas": "schemas/v1/signed_bundle.schema.json",
          "fixtures": "tests/conformance/examples/citizenship_bundle.signed.json, tests/conformance/examples/citizenship_bundle.json, keys/public_key.txt",
          "vectors": "tests/conformance/v2/golden_vectors.json#v1_bundle_verification"
        }
      ],
      "expected_cases": [
        "v1.integrity.key_metadata_consistent",
        "v1.integrity.signature",
        "v1.integrity.bundle_hash",
        "v1.integrity.merkle_root",
        "v1.integrity.intent_hash_golden",
        "v1.integrity.audit_entry_hashes_golden",
        "v1.integrity.prev_hash_chain_golden",
        "v1.integrity.chain_signed_bundle",
        "v1.integrity.chain_unsigned_bundle"
      ]
    },
    {
      "id": "v2.canonicalization",
      "title": "dcp-jcs-v1 canonical form",
      "claim": "The reference canonicalizer (tools/merkle.js) produces the expected canonical bytes for the golden and interop vectors. The edge_cases block is run by the SDK suites, not here. The dcp-jcs-v2 candidate is outside this suite.",
      "requirements": [
        {
          "spec": "spec/CANONICALIZATION_PROFILE.md, spec/DCP-AI-v2.0.md §15",
          "vectors": "tests/conformance/v2/golden_vectors.json#canonicalization, #v2_canonicalization; tests/interop/v2/interop_vectors.json#canonicalization"
        }
      ],
      "expected_cases": [
        "v2.canonicalization.golden.simple_sorted_keys",
        "v2.canonicalization.golden.nested_objects",
        "v2.canonicalization.golden.mixed_types",
        "v2.canonicalization.golden.integer_only_v2",
        "v2.canonicalization.golden.with_null",
        "v2.canonicalization.golden.unicode",
        "v2.canonicalization.golden_v2.integer_only",
        "v2.canonicalization.golden_v2.with_null",
        "v2.canonicalization.interop.agent_passport",
        "v2.canonicalization.interop.intent",
        "v2.canonicalization.interop.audit_event"
      ]
    },
    {
      "id": "v2.hashes",
      "title": "SHA-256 / SHA3-256 vectors, dual hashes and dual Merkle roots",
      "claim": "Hash, dual-hash and dual Merkle root values match the golden vectors and the V1 fixture. Golden values only: the V2 verifiers do not recompute the secondary SHA3-256 chain.",
      "requirements": [
        {
          "spec": "spec/DCP-AI-v2.0.md §2.3, §10.3",
          "vectors": "tests/conformance/v2/golden_vectors.json#hash_vectors, #dual_hash_vectors"
        }
      ],
      "expected_cases": [
        "v2.hashes.sha256_hello",
        "v2.hashes.sha3_256_hello",
        "v2.hashes.sha256_empty",
        "v2.hashes.sha3_256_empty",
        "v2.hashes.dual.raw",
