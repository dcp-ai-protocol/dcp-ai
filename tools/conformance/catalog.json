        "v2.hashes.dual.intent_matches_v1_fixture",
        "v2.hashes.dual.audit_entries",
        "v2.hashes.dual.merkle_roots"
      ]
    },
    {
      "id": "v2.signed_bundle",
      "title": "V2 signed bundle through the reference verifier",
      "claim": "A V2 bundle signed in memory with fresh keys (nothing written) verifies through lib/verify.js, and tampered, forged, stripped, pinned and legacy variants get the expected verdict under the stated mode. verified is not admission and does not authorize an action.",
      "requirements": [
        {
          "spec": "spec/VERIFICATION.md (V2), spec/DCP-AI-v2.0.md §5, §7, §18",
          "schemas": "schemas/v2/signed_bundle.schema.json and payload schemas",
          "code": "scripts/generate-v2-examples.js (buildV2Examples), lib/verify.js"
        }
      ],
      "expected_cases": [
        "v2.signed_bundle.verifies",
        "v2.signed_bundle.pinned_signer_key_verifies",
        "v2.signed_bundle.pinned_other_key_rejected",
        "v2.signed_bundle.pinned_under_pq_only_rejected",
        "v2.signed_bundle.tampered_intent_rejected",
        "v2.signed_bundle.forged_classical_signature_rejected",
        "v2.signed_bundle.forged_pq_signature_rejected_hybrid_required",
        "v2.signed_bundle.pq_stripped_rejected_hybrid_required",
        "v2.signed_bundle.schema_invalid_payload_rejected",
        "v2.signed_bundle.legacy_prenormative_envelope_rejected"
      ]
    },
    {
      "id": "v2.schema",
      "title": "V2 core artifacts: JSON Schema",
      "claim": "The V2 RPR, passport, intent and policy decision examples validate against schemas/v2. Schema validity only; on its own it does not make a V2 implementation, which also needs the canonicalization, hash and signature suites.",
      "requirements": [
        {
          "spec": "spec/DCP-AI-v2.0.md, spec/core/dcp-core.md",
          "schemas": "schemas/v2/{responsible_principal_record,agent_passport,intent,policy_decision}.schema.json",
          "fixtures": "tests/conformance/examples/{rpr,passport,intent,policy_decision}_v2.json"
