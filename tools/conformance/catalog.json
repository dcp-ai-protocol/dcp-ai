      "expected_cases": [
        "v2.schema.responsible_principal_record",
        "v2.schema.agent_passport",
        "v2.schema.intent",
        "v2.schema.policy_decision"
      ]
    },
    {
      "id": "ext.dcp05_09.schema",
      "title": "DCP-05 to DCP-09 records: JSON Schema",
      "claim": "The DCP-05 to DCP-09 example records validate against their schemas/v2 schema. Schema validity only: no signature, lifecycle, succession, dispute, rights or delegation behaviour is tested, and the records are signed declarations, not proof of what they state.",
      "limits": [
        "DCP-05: vitality_report metrics are numbers in [0, 1], but dcp-jcs-v1 only canonicalizes integers, so a signed report can only carry 0 or 1 per metric (unresolved).",
        "DCP-08 §4.3 allows organizational rights in reverse-domain notation; the right_type enum of rights_declaration.schema.json refuses them (unresolved).",
        "DCP-09 §3.2/§3.6 use effective_until; the schema and the SDKs use valid_until (unresolved).",
        "DCP-04 to DCP-09 examples use DCP-*-SIG-v2 tags and fields that differ from the schemas and the DCP-AI.v2.* contexts of the SDKs; this suite does not test signatures."
      ],
      "requirements": [
        {
          "spec": "spec/DCP-05.md … spec/DCP-09.md",
          "schemas": "schemas/v2/<record>.schema.json",
          "fixtures": "tests/conformance/examples/<record>_v2.json"
        }
      ],
      "expected_cases": [
        "ext.schema.dcp05.commissioning_certificate",
        "ext.schema.dcp05.vitality_report",
        "ext.schema.dcp05.decommissioning_record",
        "ext.schema.dcp06.digital_testament",
        "ext.schema.dcp06.succession_record",
        "ext.schema.dcp06.memory_transfer_manifest",
        "ext.schema.dcp07.dispute_record",
        "ext.schema.dcp07.arbitration_resolution",
        "ext.schema.dcp07.jurisprudence_bundle",
        "ext.schema.dcp07.objection_record",
        "ext.schema.dcp08.rights_declaration",
        "ext.schema.dcp08.obligation_record",
        "ext.schema.dcp08.rights_violation_report",
        "ext.schema.dcp09.delegation_mandate",
        "ext.schema.dcp09.advisory_declaration",
        "ext.schema.dcp09.principal_mirror",
        "ext.schema.dcp09.interaction_record",
        "ext.schema.dcp09.awareness_threshold"
      ]
    },
