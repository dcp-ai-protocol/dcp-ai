  "multiple_defects": {
    "7_key_wrong_length": {
      "allowed_codes": [
        "CONFIG_TRUST_KID_NOT_DERIVED",
        "CONFIG_TRUST_MALFORMED_KEY"
      ],
      "reasons": {
        "CONFIG_TRUST_KID_NOT_DERIVED": "Its kid is the real key's, not the kid of the bytes it lists (V2-13).",
        "CONFIG_TRUST_MALFORMED_KEY": "The Ed25519 public key is not 32 bytes long (§2.2)."
      }
    },
    "7_kid_of_other_alg": {
      "allowed_codes": [
        "CONFIG_TRUST_DUPLICATE",
        "CONFIG_TRUST_KID_NOT_DERIVED"
      ],
      "reasons": {
        "CONFIG_TRUST_DUPLICATE": "That kid is then listed twice in the set (§2.2).",
        "CONFIG_TRUST_KID_NOT_DERIVED": "The Ed25519 key carries the kid derived for the ML-DSA-65 key, not the kid of its own algorithm and bytes (V2-13)."
      }
    },
    "7_unknown_alg": {
      "allowed_codes": [
        "CONFIG_TRUST_KID_NOT_DERIVED",
        "CONFIG_TRUST_MALFORMED_KEY"
      ],
      "reasons": {
        "CONFIG_TRUST_KID_NOT_DERIVED": "Its kid is that of ed25519 with these bytes, not that of ed448 with them (V2-13).",
        "CONFIG_TRUST_MALFORMED_KEY": "alg ed448 is not ed25519, ml-dsa-65 or slh-dsa-192f (§2.2)."
      }
    }
  },
  "composed": [
    {
      "name": "profile_without_trust_set",
      "rule": "§5.1",
      "inputs": {
        "bundle": "base",
        "profile": "strict",
        "trust": null,
        "revocation": {
          "from_case": "A_known_principal_strict"
        },
        "now": "2026-11-02T10:01:00.000Z",
        "verifier_policy": null
      },
      "composes": [
        "A_known_principal_strict"
      ],
      "expected": {
        "rejected": "CONFIG_PROFILE_CONTRADICTION"
      },
      "derivation": "A_known_principal_strict without its trust set. §5.1: a profile requires a trust set; the combined function refuses the call with CONFIG_PROFILE_CONTRADICTION, before or after verification."
    },
    {
      "name": "profile_with_caller_policy",
      "rule": "§5.1",
      "inputs": {
        "bundle": "base",
        "profile": "strict",
        "trust": "principal",
        "revocation": {
          "from_case": "A_known_principal_strict"
        },
        "now": "2026-11-02T10:01:00.000Z",
        "verifier_policy": "no_profile_policy"
      },
      "composes": [
        "A_known_principal_strict"
      ],
      "expected": {
        "rejected": "CONFIG_PROFILE_CONTRADICTION"
      },
      "derivation": "A_known_principal_strict with a verifier policy of the caller's. §5.1: the combined function accepts a caller's policy only without a profile, and refuses it with a profile with CONFIG_PROFILE_CONTRADICTION."
    },
    {
      "name": "trust_then_revocation",
      "rule": "§5.2",
      "inputs": {
        "bundle": "base",
        "profile": "strict",
        "trust": "classical_revoked",
        "revocation": {
          "from_case": "13_agent_revoked"
        },
        "now": "2026-11-02T10:01:00.000Z",
        "verifier_policy": null
      },
      "composes": [
        "6_key_revoked_in_trust_set",
        "13_agent_revoked"
      ],
      "expected": {
        "result": {
          "verified": true,
          "principal_trust": "untrusted",
          "profile_compliance": "non_compliant",
          "admitted": false,
          "recorded_decision": "approve",
          "action_authorized": false,
          "codes": [
            "REVOCATION_REVOKED",
            "TRUST_KEY_REVOKED"
          ]
        }
      },
      "derivation": "The trust set of 6_key_revoked_in_trust_set and the snapshot of 13_agent_revoked, same bundle, profile and now. Step 3 evaluates trust (§3: TRUST_KEY_REVOKED, untrusted) and revocation (§4.3 R4: REVOCATION_REVOKED, non_compliant) independently. §5.2: trust codes come before revocation codes, so sorting them alphabetically breaks the order."
    },
    {
      "name": "session_then_structural_p4",
      "rule": "§5.2",
      "inputs": {
        "bundle": "classical_only",
        "profile": "strict_120_s",
        "trust": "principal",
        "revocation": "unavailable",
        "now": "2026-11-02T10:01:00.000Z",
        "verifier_policy": null
      },
      "composes": [
        "10_operator_lowers_maximum",
        "11_classical_only_bundle"
      ],
      "expected": {
        "result": {
          "verified": false,
          "principal_trust": "not_evaluated",
          "profile_compliance": "non_compliant",
          "admitted": false,
          "recorded_decision": null,
          "action_authorized": false,
          "codes": [
            "PROFILE_HYBRID_REQUIRED",
            "PROFILE_SESSION_TOO_LONG",
            "VERIFICATION_FAILED"
          ]
        }
      },
      "derivation": "The 300 s session of the classical_only bundle under the 120 s profile of 10_operator_lowers_maximum (P3: PROFILE_SESSION_TOO_LONG) and its classical binding as in 11_classical_only_bundle (structural P4: PROFILE_HYBRID_REQUIRED); it does not verify under hybrid_required (VERIFICATION_FAILED), so step 3 is not run and the revocation state is not read. §5.2: P3 comes before P4, so sorting alphabetically breaks the order."
    }
  ],
